{
  "name": "ganesh-admin-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "media:import": "node --experimental-strip-types scripts/import-media.ts",
    "test:media": "node --experimental-strip-types scripts/check-media-library.ts",
    "setup:local": "node --experimental-strip-types scripts/setup-local.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e:states": "node --test tests/cms-state.e2e.mjs",
    "test:e2e:dialogs": "node --test tests/admin-dialog.e2e.mjs",
    "test:e2e:responsive": "node tests/admin-responsive.e2e.mjs",
    "seed:content": "node --experimental-strip-types scripts/seed-content.ts",
    "migrate:content": "node --experimental-strip-types scripts/extend-content.ts",
    "create:admin": "node --experimental-strip-types scripts/create-admin.ts",
    "validate:content": "node --experimental-strip-types scripts/validate-content-seed.ts"
  },
  "dependencies": {
    "@next/env": "16.3.4",
    "mysql2": "^3.19.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.10.1"
}
