# XAMPP MySQL/MariaDB connection (create this database in phpMyAdmin first)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ganesh_cms
MYSQL_USER=ganesh_app
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false

# Uploaded images are written under this directory by the Node server.
CMS_MEDIA_DIR=C:/xampp/htdocs/ganesh-admin-website/var/media
# Optional existing public website checkout, used to import originals into Media Library.
# PUBLIC_REPO_PATH=C:/xampp/htdocs/ganesh-website
# Public URL of the admin server, so the public website can load uploaded files.
CMS_MEDIA_ORIGIN=http://localhost:3001
ADMIN_SITE_ORIGIN=http://localhost:3001
# Local development only; enables image optimization for this exact loopback origin.
CMS_ALLOW_LOCAL_MEDIA=true

# New administrator creation is CLI-only; supply these only while running create:admin.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=

# Publish asks the public site to invalidate its content cache.
PUBLIC_SITE_REVALIDATE_URL=http://localhost:3000/api/revalidate
PUBLIC_SITE_REVALIDATE_SECRET=
PUBLIC_SITE_ORIGIN=http://localhost:3000
# Private visual-editor sessions are short-lived and are consumed only by the public preview route.
# Set the public site's CMS_ADMIN_PREVIEW_ORIGIN to this same admin origin.
CMS_ADMIN_PREVIEW_ORIGIN=http://localhost:3001
